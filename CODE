cntct = {}
while True:
    print("1.Add")
    print("2.Search")
    print("3.Update")
    print("4.Delete")
    print("5.Exit")
    ch = input("Enter choice: ")
    if ch == "1":
        n = input("Enter name: ")
        ph = input("Enter phone: ")
        cntct[n] = ph
        print("Contact added!")
    elif ch == "2":
        n = input("Enter name: ")
        print(cntct.get(n, "Contact not found"))
    elif ch == "3":
        n = input("Enter name: ")
        if n in cntct:
            cntct[n] = input("Enter new phone:")
            print("Contact updated")
        else:
            print("Contact not found")
    elif ch == "4":
        n = input("Enter name: ")
        if n in cntct:
            del cntct[n]
            print("Contact deleted")
        else:
            print("Contact not found")
    elif ch == "5":
        break
    else:
        print("Invalid choice")
